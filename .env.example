# Supabase PostgreSQL
# Use the pooled URL for runtime queries and the direct URL for migrations.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Cloudinary uploads
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Fixed admin login for /admin
ADMIN_EMAIL="admin@johnventsapexleague.com"
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""

# Public site fallback. Browser auth redirects use the current URL first.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Public user auth
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Vercel production URL example
# NEXT_PUBLIC_SITE_URL="https://your-vercel-domain.vercel.app"
